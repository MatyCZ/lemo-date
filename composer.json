{
  "name": "matycz/lemo-date",
  "description": "Date utilities: difference between dates in days, months and years, and Czech and Slovak public holidays with their history",
  "license": "BSD-3-Clause",
  "type": "library",
  "keywords": [
    "czech",
    "date",
    "diff",
    "easter",
    "holidays",
    "public holidays",
    "slovak"
  ],
  "homepage": "https://github.com/MatyCZ/lemo-date",
  "authors": [
    {
      "name": "Matej Szendi"
    }
  ],
  "autoload": {
    "psr-4": {
      "Lemo\\Date\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LemoTest\\Date\\": "tests/"
    }
  },
  "require": {
    "ext-calendar": "*",
    "php": "^8.3"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "~3.95.0",
    "phpstan/phpstan": "~2.2.0",
    "phpunit/phpunit": "^12.5",
    "rector/rector": "^2.6"
  },
  "scripts": {
    "rector": "rector process",
    "rector-check": "rector process --dry-run",
    "static-analysis": "phpstan analyse -c phpstan.neon --memory-limit=1G",
    "test": "phpunit"
  }
}
